{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 120,
  "trailingComma": "all",
  // Written by `cargo xtask protocol-ts`, which checks it byte for byte.
  "ignorePatterns": ["packages/protocol/src/generated.ts"]
}

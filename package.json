{
  "name": "letterbox",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "node packages/dev-host/src/main.ts",
    "dev:desktop": "node packages/dev-host/src/main.ts --desktop --state .letterbox/desktop",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern lint/fixtures",
    "lint:selftest": "node lint/selftest.ts && node lint/commit-title.ts --selftest",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "scenarios": "node packages/harness/src/run.ts",
    "check:app-host": "node packages/harness/src/app-host.ts",
    "bench": "node packages/harness/src/bench.ts",
    "bench:scale": "node packages/harness/src/bench.ts --sizes 10000,100000 --runs 1 --label scale",
    "check:rust": "cargo xtask provider-names && cargo xtask file-size && cargo xtask protocol-ts --check && cargo fmt --check && cargo clippy --all-targets --quiet -- -D warnings && cargo test --quiet --package xtask --package letterbox-core",
    "check": "pnpm check:without-breaks && pnpm scenarios:selftest",
    "check:without-breaks": "pnpm fmt:check && pnpm typecheck && pnpm lint && pnpm check:rust && pnpm lint:selftest && pnpm selfcheck:sim-provider && pnpm selfcheck:client && pnpm scenarios && pnpm check:app-host && pnpm check:ui && pnpm check:electron",
    "selfcheck:sim-provider": "node packages/sim-provider/src/selfcheck.ts && node packages/sim-provider/src/selfcheck-send.ts",
    "selfcheck:client": "node packages/client/src/selfcheck.ts",
    "scenarios:selftest": "node packages/harness/src/mutations.ts",
    "check:ui": "node packages/dev-host/src/ui-check.ts",
    "check:electron": "node packages/dev-host/src/electron-check.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.93.0",
    "@types/node": "^24.19.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "pnpm@11.10.0"
}
